# Gabarit d'environnement — copier vers .env (jamais commité)
#   cp .env.example .env

# --- Général ---------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME=3DPAY

# --- Persistance -----------------------------------------------------------
# DEV/tests : SQLite (fichier local, zéro installation)
# PROD      : PostgreSQL (ex. sqlite:///./3dpay.db → postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./3dpay.db

# --- Sessions du tableau de bord -------------------------------------------
SESSION_TTL_HOURS=24

# --- Transactions ----------------------------------------------------------
# Délai après lequel une demande non décidée passe automatiquement en EXPIRED
TRANSACTION_TTL_MINUTES=30

# --- Webhooks signés (HMAC) ------------------------------------------------
WEBHOOK_SECRET=changez-ce-secret-avant-toute-mise-en-ligne
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=2
WEBHOOK_RETRY_DELAY_SECONDS=0
# true = protection SSRF active (refus des URL locales/privées).
# Ne passer à false que pour une démonstration locale d'un récepteur sur 127.0.0.1.
WEBHOOK_BLOCK_PRIVATE=true

# --- Limitation du débit ---------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PAYMENTS_PER_MINUTE=60
